<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:ODExplorer.Models">

    <!--#region Spansh Route Rows-->
    <!--Shared by the route system list and by the per type body grids. Progress colouring lives on the cell
        styles below, not here. DataGrid.AlternatingRowBackground is transferred onto DataGridRow.Background by
        a coercion callback, which runs after style triggers and would win, leaving the row grey while a
        Foreground trigger still applied. Cell backgrounds are not transferred, so they always hold.-->
    <Style x:Key="SpanshCsvRowStyle"
           TargetType="{x:Type DataGridRow}">
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="IsHitTestVisible"
                Value="False" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{DynamicResource PrimaryControlForeground}" />
        <Setter Property="BorderBrush"
                Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="BorderBrush"
                        Value="Transparent" />
                <Setter Property="BorderThickness"
                        Value="0" />
            </Trigger>
            <!--No Foreground change here. Selection is drawn as a border on the cell, so the original
                Foreground="Black" would only have made an unfilled selected row unreadable.-->
            <Trigger Property="IsSelected"
                     Value="True">
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="BorderBrush"
                        Value="Transparent" />
                <Setter Property="BorderThickness"
                        Value="0" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!--#endregion-->

    <!--#region Spansh Route Cells-->
    <!--Background and Foreground are always set as a pair so text can never end up the same colour as what is
        behind it. Used by the body grids in SpanshCSVDetailsControl.-->
    <Style x:Key="SpanshCsvCell"
           TargetType="{x:Type DataGridCell}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderBrush"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Progress}"
                         Value="{x:Static models:SpanshProgressState.Scanned}">
                <Setter Property="Background"
                        Value="{DynamicResource SpanshProgressPartialBackground}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource SpanshProgressPartialForeGround}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Progress}"
                         Value="{x:Static models:SpanshProgressState.Gathered}">
                <Setter Property="Background"
                        Value="{DynamicResource BioAnalysed}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource SpanshProgressOnColourForeGround}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Progress}"
                         Value="{x:Static models:SpanshProgressState.Sold}">
                <Setter Property="Background"
                        Value="{DynamicResource BioSold}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource SpanshProgressOnColourForeGround}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--Route system list. The System column is star sized so this cell fills the row and the progress fill
        spans the full width. Selection is drawn as a border rather than a background fill, the way
        CmdrSelectionCellLeft does it, so the current system and its progress are both visible at once. That
        needs its own template because CmdrSelectionCellLeft hard codes BorderThickness="0" on its border
        instead of template binding it.-->
    <Style x:Key="SpanshCsvCellLeft"
           TargetType="{x:Type DataGridCell}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderBrush"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <Border Name="border"
                            Padding="0"
                            CornerRadius="0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Name="content" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!--Declared before the progress triggers on purpose. The border applies either way, but Foreground
                has to be restated here or the default DataGridCell theme style's own IsSelected trigger sets it
                to SystemColors.HighlightTextBrush, which is dark and unreadable on an unfilled row. Putting it
                first lets a progress trigger below override it, so a filled row keeps its paired text colour.-->
            <Trigger Property="IsSelected"
                     Value="True">
                <Setter Property="BorderBrush"
                        Value="{DynamicResource PrimaryBorder}" />
                <Setter Property="BorderThickness"
                        Value="2" />
                <Setter Property="Foreground"
                        Value="{DynamicResource PrimaryControlForeground}" />
            </Trigger>
            <DataTrigger Binding="{Binding Progress}"
                         Value="{x:Static models:SpanshProgressState.Scanned}">
                <Setter Property="Background"
                        Value="{DynamicResource SpanshProgressPartialBackground}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource SpanshProgressPartialForeGround}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Progress}"
                         Value="{x:Static models:SpanshProgressState.Gathered}">
                <Setter Property="Background"
                        Value="{DynamicResource BioAnalysed}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource SpanshProgressOnColourForeGround}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Progress}"
                         Value="{x:Static models:SpanshProgressState.Sold}">
                <Setter Property="Background"
                        Value="{DynamicResource BioSold}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource SpanshProgressOnColourForeGround}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!--#endregion-->

    <!--#region Progress Legend-->
    <Style x:Key="SpanshProgressLegendSwatch"
           TargetType="{x:Type Border}">
        <Setter Property="Width"
                Value="14" />
        <Setter Property="Height"
                Value="14" />
        <Setter Property="Margin"
                Value="10,0,5,0" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>
    <!--#endregion-->
</ResourceDictionary>
